generator client {
  provider = "prisma-client-js"
  // "native" for local/CI, rhel-openssl-3.0.x for Vercel functions: the production
  // build runs on the GitHub runner (vercel build --prebuilt) but executes on Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
}

model Order {
  id         String      @id @default(cuid())
  code       String      @unique
  customer   String
  totalCents Int
  costCents  Int
  status     OrderStatus @default(PENDING)
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status, position])
  @@index([createdAt])
}
